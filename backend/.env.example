# Copiar a .env y completar localmente. Nunca versionar el archivo .env.
# Clave privada obligatoria: generar una propia con los mecanismos de Django.
DJANGO_SECRET_KEY=
# Si se omite, DEBUG permanece desactivado. Activar solo para desarrollo local.
DJANGO_DEBUG=False
# Lista de hosts separados por comas, sin esquema ni puerto.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL local. Completar la contraseña sin publicarla.
DB_NAME=becanexo_db
DB_USER=becanexo_app
DB_PASSWORD=
DB_HOST=localhost
# Puerto opcional; por defecto se utiliza 5432.
DB_PORT=5432

# False para HTTP local; configurar ambas en True bajo HTTPS.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# Solo para el frontend local Vite; sin comodines ni CORS abierto.
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173
AUTH_REGISTRO_RATE=5/hour
AUTH_LOGIN_RATE=10/minute
