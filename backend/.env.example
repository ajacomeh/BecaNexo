# Copiar a .env y completar localmente. Nunca versionar el archivo .env.
# Clave privada obligatoria: generar una propia con los mecanismos de Django.
DJANGO_SECRET_KEY=
# Si se omite, DEBUG permanece desactivado. Activar solo para desarrollo local.
DJANGO_DEBUG=False
# Lista de hosts separados por comas, sin esquema ni puerto.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL local. Completar la contraseña sin publicarla.
DB_NAME=becanexo_db
DB_USER=becanexo_app
DB_PASSWORD=
DB_HOST=localhost
# Puerto opcional; por defecto se utiliza 5432.
DB_PORT=5432

# False para HTTP local; configurar ambas en True bajo HTTPS.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# El proxy local conserva Host y Origin; normalmente no se necesitan orígenes adicionales.
# Configurar solo orígenes distintos aprobados explícitamente; sin comodines ni CORS abierto.
DJANGO_CSRF_TRUSTED_ORIGINS=
AUTH_REGISTRO_RATE=5/hour
AUTH_LOGIN_RATE=10/minute

# Directorio privado fuera del repositorio; incluirlo en respaldos conjuntos.
RASTREO_STORAGE_ROOT=D:/Datos_BecaNexo/rastreo

# Correo: inactivo hasta aplicar notificaciones.0002 y autorizar su uso.
AVISOS_CORREO_HABILITADOS=False
GMAIL_SMTP_USER=
GMAIL_APP_PASSWORD=
# URL del frontend que recibirá la persona en el correo.
BECANEXO_PUBLIC_BASE_URL=http://127.0.0.1:5173
